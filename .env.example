VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/onsus-stage
VITE_API_AUTH_TOKEN_TYPE=id
VITE_PRODUCTS_ENDPOINT=/products
VITE_WISHLIST_ENDPOINT=/wishlist
