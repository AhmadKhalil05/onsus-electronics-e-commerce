VITE_NEWSLETTER_ENDPOINT=/newsletter/subscribe
VITE_NEWSLETTER_BASE_URL=

VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxx
VITE_COGNITO_USER_POOL_CLIENT_ID=CUPCI....
VITE_COGNITO_HOSTED_UI_DOMAIN=your-cognito-domain.auth.us-east-1.amazoncognito.com

